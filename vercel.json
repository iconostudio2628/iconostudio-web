{
  "buildCommand": "npm run build && node scripts/publish.mjs",
  "outputDirectory": "public",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/oboci-kosmetika-praha-2/",
      "destination": "/oboci-praha-2/",
      "permanent": true
    },
    {
      "source": "/en/brows-facials-prague-2/",
      "destination": "/en/brows-prague-2/",
      "permanent": true
    },
    {
      "source": "/de/augenbrauen-kosmetik-prag-2/",
      "destination": "/de/augenbrauen-prag-2/",
      "permanent": true
    },
    {
      "source": "/gelove-akrylové-nehty-praha-2/",
      "destination": "/gelove-akrylove-nehty-praha-2/",
      "permanent": true
    },
    {
      "source": "/gelove-akrylov%C3%A9-nehty-praha-2/",
      "destination": "/gelove-akrylove-nehty-praha-2/",
      "permanent": true
    },
    {
      "source": "/akce-manikura-pedikura/",
      "destination": "/akce-15-procent/",
      "permanent": true
    },
    {
      "source": "/en/manicure-pedicure-offer/",
      "destination": "/en/offer-15-percent/",
      "permanent": true
    },
    {
      "source": "/de/manikuere-pedikuere-aktion/",
      "destination": "/de/aktion-15-prozent/",
      "permanent": true
    }
  ]
}
